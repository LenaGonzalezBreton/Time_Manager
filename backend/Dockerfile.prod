# backend/Dockerfile.prod
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build || echo "no build step"

FROM node:18-alpine
WORKDIR /app
COPY --from=builder /app ./
RUN npm ci --omit=dev
ENV NODE_ENV=production
EXPOSE 5000
CMD ["npm", "start"]
