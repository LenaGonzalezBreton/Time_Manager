{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment Settings
    // Using "bundler" to allow imports without .js extensions during build
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    // Fusion des types nécessaires (Jest + Supertest)
    "types": [
      "node",
      "cors",
      "jest",
      "@types/supertest"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // Note: "allowImportingTsExtensions" retiré pour permettre la génération des fichiers dans /dist
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Decorators (CRUCIAL pour TypeORM)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "auto",
    "skipLibCheck": true
  },
  // Fusion des inclusions et exclusions
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts"
  ]
}