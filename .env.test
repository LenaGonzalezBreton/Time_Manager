# ==============================================
# Configuration des Tests - Time Manager
# ==============================================

# ----------------------------------------------
# Base de données PostgreSQL pour les tests
# ----------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=time_manager_test

# URL de connexion pour les tests (utilise localhost pour les tests locaux)
DATABASE_URL=postgres://user:password@localhost:5432/time_manager_test

# ----------------------------------------------
# Backend API - Configuration de test
# ----------------------------------------------
API_PORT=5001

# Logs SQL désactivés pour les tests (pour ne pas polluer la sortie)
TYPEORM_LOGGING=false
SQL_DEBUG=false

# Environnement de test
NODE_ENV=test

# CORS pour les tests
FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------------------------
# Frontend
# ----------------------------------------------
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:5001/api